# Copie este arquivo para .env

# Endereço da API. Deixe /api/v1: passa pelo proxy do Vite (npm run dev e npm run preview).
# Com a URL completa da API o navegador chama a API direto e ela recusa por CORS.
VITE_API_URL=/api/v1

# Para onde o proxy do Vite manda o /api em desenvolvimento.
# API publicada: https://reciclabairro-api.vercel.app | back rodando local: http://localhost:3000
VITE_API_PROXY=https://reciclabairro-api.vercel.app
